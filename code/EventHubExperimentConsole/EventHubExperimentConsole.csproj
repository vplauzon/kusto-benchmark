		<PackageReference Include="Microsoft.Azure.Kusto.Data" Version="14.2.2" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="SharpYaml" Version="3.13.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\EventHubConsole\EventHubConsole.csproj" />
	</ItemGroup>

</Project>
